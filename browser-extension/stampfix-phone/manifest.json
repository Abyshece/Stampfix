{
  "manifest_version": 3,
  "name": "Stampfix Phone",
  "short_name": "Stampfix Phone",
  "description": "Instagram in a phone-sized side panel next to the Stampfix admin panel, for sending outreach messages.",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://ig.me/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open the Stampfix phone",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://stampfix.app/*",
        "https://www.stampfix.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "mobile.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "type.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
