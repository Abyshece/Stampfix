# Supabase
# Get these from Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Sentry (error monitoring) - optional
# Get this from sentry.io -> your project -> Settings -> Client Keys (DSN)
# Leave blank to disable monitoring (no-op).
VITE_SENTRY_DSN=

# Google Wallet (used by the Edge Function, not the frontend)
# Set these via: supabase secrets set GOOGLE_WALLET_ISSUER_ID=... etc
# Don't put them here.
