# Supabase
# Get these from Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Sentry (error monitoring) - optional
# Get this from sentry.io -> your project -> Settings -> Client Keys (DSN)
# Leave blank to disable monitoring (no-op).
VITE_SENTRY_DSN=

# Cloudflare Turnstile (anti-bot CAPTCHA) - optional
# Get the SITE key from dash.cloudflare.com -> Turnstile -> your site
# Leave blank to disable the CAPTCHA widget entirely (form still works
# but bots aren't blocked). The matching SECRET key goes to Supabase
# secrets: `supabase secrets set TURNSTILE_SECRET_KEY=...`
VITE_TURNSTILE_SITE_KEY=

# Stripe (subscription billing) - optional
# PUBLISHABLE key (safe to expose). Get it from dashboard.stripe.com
# -> Developers -> API keys. Use pk_test_... while in Test Mode and
# pk_live_... in production. Leave blank to show "Almost ready!"
# placeholder instead of real checkout. The SECRET key goes to
# Supabase secrets: `supabase secrets set STRIPE_SECRET_KEY=...`
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Wallet (used by the Edge Function, not the frontend)
# Set these via: supabase secrets set GOOGLE_WALLET_ISSUER_ID=... etc
# Don't put them here.
